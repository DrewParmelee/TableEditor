<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- AO Color Palette -->
    <Color x:Key="AoBlueColor">#00426A</Color>
    <Color x:Key="AoBlueDarkColor">#06274A</Color>

    <Color x:Key="AoSteelDarkColor">#1C7099</Color>
    <Color x:Key="AoSteelColor">#207DAA</Color>

    <Color x:Key="AoAttentionLightColor">#A4DCF7</Color>
    <Color x:Key="AoSkyLightColor">#E4F4FE</Color>

    <Color x:Key="AoCharcoalColor">#444444</Color>
    <Color x:Key="AoGraphiteColor">#666666</Color>
    <Color x:Key="AoAshColor">#949494</Color>
    <Color x:Key="AoSmokeColor">#DCDCDC</Color>
    <Color x:Key="AoFogColor">#F4F4F4</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AoBlueBrush" Color="{StaticResource AoBlueColor}"/>
    <SolidColorBrush x:Key="AoBlueDarkBrush" Color="{StaticResource AoBlueDarkColor}"/>
    <SolidColorBrush x:Key="AoSteelBrush" Color="{StaticResource AoSteelColor}"/>
    <SolidColorBrush x:Key="AoAttentionLightBrush" Color="{StaticResource AoAttentionLightColor}"/>
    <SolidColorBrush x:Key="AoSkyLightBrush" Color="{StaticResource AoSkyLightColor}"/>
    <SolidColorBrush x:Key="AoCharcoalBrush" Color="{StaticResource AoCharcoalColor}"/>
    <SolidColorBrush x:Key="AoGraphiteBrush" Color="{StaticResource AoGraphiteColor}"/>
    <SolidColorBrush x:Key="AoAshBrush" Color="{StaticResource AoAshColor}"/>
    <SolidColorBrush x:Key="AoSmokeBrush" Color="{StaticResource AoSmokeColor}"/>
    <SolidColorBrush x:Key="AoFogBrush" Color="{StaticResource AoFogColor}"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="AoBlueGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AoBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AoBlueDarkColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Menu -->
    <Style x:Key="MainMenuStyle" TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource AoBlueGradientBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="TopMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource AoCharcoalBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="20,5"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- Left table list -->
    <Style x:Key="TableListStyle" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource AoCharcoalBrush}"/>
    </Style>

    <!-- DataGrid -->
    <Style x:Key="RatingGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserResizeRows" Value="False"/>

        <!-- Column headers must exist for WPF column resizing to work -->
        <Setter Property="HeadersVisibility" Value="Column"/>

        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AoSmokeBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource AoSmokeBrush}"/>
        <Setter Property="SelectionUnit" Value="Cell"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="FontSize" Value="14"/>

        <!-- Fixed height helps avoid jumpy scrolling -->
        <Setter Property="RowHeight" Value="22"/>
        <Setter Property="MinRowHeight" Value="22"/>

        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>

        <Setter Property="Background" Value="{StaticResource AoFogBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AoSmokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- Thin header strip used only for column resizing -->
    <Style x:Key="ResizeOnlyColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="6"/>
        <Setter Property="MinHeight" Value="6"/>
        <Setter Property="Background" Value="{StaticResource AoSmokeBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AoSmokeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Content" Value=""/>
    </Style>

    <Style x:Key="RowHeaderCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="{StaticResource AoSkyLightBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AoCharcoalBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AoSmokeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="4,0"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding [__RowKind]}" Value="Header">
                <Setter Property="Background" Value="{StaticResource AoBlueBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>

            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AoAttentionLightBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AoCharcoalBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ValueCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource AoCharcoalBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AoSmokeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="4,0"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding [__RowKind]}" Value="Header">
                <Setter Property="Background" Value="{StaticResource AoSkyLightBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AoCharcoalBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>

            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AoAttentionLightBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AoCharcoalBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>