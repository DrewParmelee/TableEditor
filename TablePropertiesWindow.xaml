<Window x:Class="AOTableEditor.TablePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AOTableEditor"
        Title="Table Properties"
        Height="620"
        Width="860"
        MinHeight="500"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AoAppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/AOStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InlineEditorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SearchTypeComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Width" Value="70"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="5,1"/>
            </Style>

            <Style x:Key="PropertiesListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="PropertiesListBoxStyle" TargetType="ListBox">
                <Setter Property="BorderBrush" Value="{StaticResource AoLineBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{StaticResource AoSurfaceBrush}"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource PropertiesListBoxItemStyle}"/>
            </Style>

            <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource AoCharcoalBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SecondaryHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelHeaderStyle}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource AoGraphiteBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <DataTemplate x:Key="SetEditorItemTemplate">
                <Grid Height="28"
                      Margin="0,1"
                      MouseLeftButtonDown="SetEditorItem_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="74"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <TextBlock Text="{Binding Name}"
                                   Padding="6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AoCharcoalBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="InlineEditor_LostFocus"
                                 KeyDown="InlineEditor_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource InlineEditorTextBoxStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <ComboBox Grid.Column="1"
                              Style="{StaticResource SearchTypeComboBoxStyle}"
                              ItemsSource="{Binding Source={x:Static local:TablePropertiesWindow.SearchTypeOptions}}"
                              SelectedItem="{Binding SearchType, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="KeyEditorItemTemplate">
                <Grid Height="28"
                      Margin="0,1"
                      MouseLeftButtonDown="KeyEditorItem_MouseLeftButtonDown">
                    <TextBlock Text="{Binding Value}"
                               Padding="6,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource AoCharcoalBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="InlineEditor_LostFocus"
                             KeyDown="InlineEditor_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource InlineEditorTextBoxStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Table Name"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AoCharcoalBrush}"/>

            <TextBox x:Name="TableNameTextBox"
                     Grid.Row="1"
                     Height="28"
                     Margin="0,6,0,10"
                     Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged}"/>

            <Grid Grid.Row="2"
                  Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Data Type"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AoCharcoalBrush}"/>

                    <ComboBox Height="28"
                              Margin="0,6,0,0"
                              ItemsSource="{Binding Source={x:Static local:TablePropertiesWindow.DataTypeOptions}}"
                              SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Decimals"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AoCharcoalBrush}"/>

                    <TextBox Height="28"
                             Width="72"
                             Margin="0,6,0,0"
                             HorizontalAlignment="Left"
                             IsEnabled="{Binding IsDecimalsEnabled}"
                             Text="{Binding DecimalsText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3"
                       Text="Comment"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AoCharcoalBrush}"/>

            <TextBox Grid.Row="4"
                     MinHeight="30"
                     MaxHeight="78"
                     Margin="0,6,0,12"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <TabControl Grid.Row="1"
                    BorderBrush="{StaticResource AoLineBrush}"
                    Background="{StaticResource AoSurfaceBrush}">
            <TabItem Header="Row Sets">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="74"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Sets"
                                       Style="{StaticResource PanelHeaderStyle}"/>

                            <TextBlock Grid.Column="1"
                                       Text="Search"
                                       Style="{StaticResource SecondaryHeaderStyle}"/>
                        </Grid>

                        <ListBox x:Name="RowSetsList"
                                 Grid.Row="1"
                                 Margin="0,6,0,8"
                                 ItemsSource="{Binding RowSets}"
                                 Style="{StaticResource PropertiesListBoxStyle}"
                                 ItemTemplate="{StaticResource SetEditorItemTemplate}"/>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal">
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Add Set" Click="AddRowSet_Click"><TextBlock Text="+"/></Button>
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Delete Set" Click="DeleteRowSet_Click"><TextBlock Text="-"/></Button>
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Move Up" Click="MoveRowSetUp_Click"><TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets"/></Button>
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Move Down" Click="MoveRowSetDown_Click"><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"/></Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Keys"
                                   Style="{StaticResource PanelHeaderStyle}"/>

                        <ListBox x:Name="RowKeysList"
                                 Grid.Row="1"
                                 Margin="0,6,0,8"
                                 ItemsSource="{Binding SelectedItem.Keys, ElementName=RowSetsList}"
                                 Style="{StaticResource PropertiesListBoxStyle}"
                                 ItemTemplate="{StaticResource KeyEditorItemTemplate}"/>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal">
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Add Key" Click="AddRowKey_Click"><TextBlock Text="+"/></Button>
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Delete Key" Click="DeleteRowKey_Click"><TextBlock Text="-"/></Button>
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Move Up" Click="MoveRowKeyUp_Click"><TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets"/></Button>
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Move Down" Click="MoveRowKeyDown_Click"><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"/></Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Column Sets">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="74"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Sets"
                                       Style="{StaticResource PanelHeaderStyle}"/>

                            <TextBlock Grid.Column="1"
                                       Text="Search"
                                       Style="{StaticResource SecondaryHeaderStyle}"/>
                        </Grid>

                        <ListBox x:Name="ColumnSetsList"
                                 Grid.Row="1"
                                 Margin="0,6,0,8"
                                 ItemsSource="{Binding ColumnSets}"
                                 Style="{StaticResource PropertiesListBoxStyle}"
                                 ItemTemplate="{StaticResource SetEditorItemTemplate}"/>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal">
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Add Set" Click="AddColumnSet_Click"><TextBlock Text="+"/></Button>
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Delete Set" Click="DeleteColumnSet_Click"><TextBlock Text="-"/></Button>
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Move Up" Click="MoveColumnSetUp_Click"><TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets"/></Button>
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Move Down" Click="MoveColumnSetDown_Click"><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"/></Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Keys"
                                   Style="{StaticResource PanelHeaderStyle}"/>

                        <ListBox x:Name="ColumnKeysList"
                                 Grid.Row="1"
                                 Margin="0,6,0,8"
                                 ItemsSource="{Binding SelectedItem.Keys, ElementName=ColumnSetsList}"
                                 Style="{StaticResource PropertiesListBoxStyle}"
                                 ItemTemplate="{StaticResource KeyEditorItemTemplate}"/>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal">
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Add Key" Click="AddColumnKey_Click"><TextBlock Text="+"/></Button>
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Delete Key" Click="DeleteColumnKey_Click"><TextBlock Text="-"/></Button>
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Move Up" Click="MoveColumnKeyUp_Click"><TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets"/></Button>
                            <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Move Down" Click="MoveColumnKeyDown_Click"><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"/></Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Pages">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Search Type"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource PanelHeaderStyle}"/>

                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource SearchTypeComboBoxStyle}"
                                  ItemsSource="{Binding Source={x:Static local:TablePropertiesWindow.SearchTypeOptions}}"
                                  SelectedItem="{Binding PageSearchType, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="Pages"
                               Style="{StaticResource PanelHeaderStyle}"/>

                    <ListBox x:Name="PagesList"
                             Grid.Row="2"
                             Margin="0,6,0,8"
                             ItemsSource="{Binding Pages}"
                             Style="{StaticResource PropertiesListBoxStyle}"
                             ItemTemplate="{StaticResource KeyEditorItemTemplate}"/>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Add Page" Click="AddPage_Click"><TextBlock Text="+"/></Button>
                        <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Delete Page" Click="DeletePage_Click"><TextBlock Text="-"/></Button>
                        <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Move Up" Click="MovePageUp_Click"><TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets"/></Button>
                        <Button Style="{StaticResource MiniIconButtonStyle}" ToolTip="Move Down" Click="MovePageDown_Click"><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"/></Button>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   Foreground="#D1002A"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Update"
                    Width="86"
                    IsDefault="True"
                    Click="Update_Click"/>
            <Button Content="Cancel"
                    Width="86"
                    Margin="8,0,0,0"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
