<Window x:Class="AOTableEditor.ChoicePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose"
        Height="320"
        Width="420"
        MinHeight="240"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AoAppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/AOStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptLabel"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource AoCharcoalBrush}"
                   Margin="0,0,0,8"/>

        <ListBox x:Name="ChoicesList"
                 Grid.Row="1"
                 Style="{StaticResource TableListStyle}"
                 ItemContainerStyle="{StaticResource TableListItemStyle}"
                 MouseDoubleClick="ChoicesList_MouseDoubleClick"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Choose"
                    Width="86"
                    IsDefault="True"
                    Click="Choose_Click"/>
            <Button Content="Cancel"
                    Width="86"
                    Margin="8,0,0,0"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
